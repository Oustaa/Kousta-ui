# Public API URL for docs live previews (AsyncSelect, DataTable examples).
# Inlined in the browser — use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# DocSearch (Algolia) — optional. Leave unset to fall back to Nextra's
# built-in local search. All three must be set to enable DocSearch.
#
# NEXT_PUBLIC_DOCSEARCH_SEARCH_API_KEY must be the public "Search-Only API
# Key" from your Algolia app, NOT the admin/write key used by the scraper
# (that one is a separate secret, only ever used server-side in CI — see
# DOCSEARCH_API_KEY in .github/workflows/deploy-docs.yml). The search-only
# key is safe to expose in the browser bundle; the admin key is not.
NEXT_PUBLIC_DOCSEARCH_APP_ID=
NEXT_PUBLIC_DOCSEARCH_SEARCH_API_KEY=
NEXT_PUBLIC_DOCSEARCH_INDEX_NAME=
