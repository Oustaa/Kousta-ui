lerna-debug.log*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.pnpm-store/

# Dependency directories
**/node_modules
**/dist
**/.cache

# Build output (package build artifacts only — do not use bare patterns here,
# they will also match legitimate app source dirs like docs/src/lib)
packages/*/dist/
packages/*/build/
packages/*/lib/
packages/*/cjs/
packages/*/esm/
.next/
**/.next/

# Temporary files
temp/
tmp/
*.tmp
*.swp
*.swo
*.pid

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Storybook
.out/
.storybook-static/
storybook-static/
node_modules/.cache/storybook/

# Coverage files
coverage/
.nyc_output/
.vscode-test/

# Lerna
lerna-debug.log

# VSCode
.vscode/
.idea/

